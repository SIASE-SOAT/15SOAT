<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <groupId>br.com.fiap</groupId>
    <artifactId>siase-parent</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>SIASE - Parent</name>
    <description>Sistema Integrado de Atendimento e Execucao de Servicos - Fase 2</description>

    <modules>
        <module>siase-domain</module>
        <module>siase-application</module>
        <module>siase-infrastructure</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <springdoc.version>2.4.0</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <stella.version>2.1.6</stella.version>
        <jacoco.version>0.8.11</jacoco.version>
        <sonar.version>4.0.0.4121</sonar.version>
        <sonar.projectKey>br.com.fiap:siase</sonar.projectKey>
        <sonar.projectName>siase</sonar.projectName>
        <sonar.host.url>http://localhost:9000</sonar.host.url>
        <sonar.coverage.exclusions>
            **/SiaseApplication.java,
            **/exception/BusinessException.java,
            **/exception/ResourceNotFoundException.java,
            **/infrastructure/config/OpenApiConfig.java,
            **/infrastructure/config/SecurityConfig.java,
            **/domain/enums/StatusOS.java,
            **/domain/enums/TipoPessoa.java,
            **/dto/**
        </sonar.coverage.exclusions>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.fiap</groupId>
                <artifactId>siase-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap</groupId>
                <artifactId>siase-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.caelum.stella</groupId>
                <artifactId>caelum-stella-bean-validation</artifactId>
                <version>${stella.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
