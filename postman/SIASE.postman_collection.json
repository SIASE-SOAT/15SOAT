    {
      "name": "Ordens de Serviço",
      "description": "Fluxo completo de OS: preparação da abertura por documento/placa → criação → diagnóstico → aprovação → execução → finalização → pagamento → entrega.\n\nNOVO: endpoint GET /ordens/preparar-abertura para identificar o cliente por CPF/CNPJ e validar a placa antes da criação da OS.\n\nStatus possíveis: RECEBIDA | EM_DIAGNOSTICO | AGUARDANDO_APROVACAO | EM_EXECUCAO | FINALIZADA | ENTREGUE | CANCELADA\n\nO endpoint GET /ordens/acompanhar/{numero} é público (sem token).",
      "item": [
        {
          "name": "Preparar abertura da OS (somente documento)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.cliente && body.cliente.id) {",
                  "        pm.collectionVariables.set('clienteId', body.cliente.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ordens/preparar-abertura?documento={{clienteDocumento}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordens", "preparar-abertura"],
              "query": [
                {
                  "key": "documento",
                  "value": "{{clienteDocumento}}",
                  "description": "CPF/CNPJ do cliente a ser identificado"
                }
              ]
            },
            "description": "Identifica o cliente por CPF/CNPJ e retorna os veículos ativos dele. Salva {{clienteId}} automaticamente quando encontrado."
          }
        },
        {
          "name": "Preparar abertura da OS (documento + placa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.cliente && body.cliente.id) {",
                  "        pm.collectionVariables.set('clienteId', body.cliente.id);",
                  "    }",
                  "    if (body.veiculoSelecionado && body.veiculoSelecionado.id) {",
                  "        pm.collectionVariables.set('veiculoId', body.veiculoSelecionado.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ordens/preparar-abertura?documento={{clienteDocumento}}&placa={{veiculoPlaca}}",
              "host": ["{{baseUrl}}"],
              "path": ["ordens", "preparar-abertura"],
              "query": [
                {
                  "key": "documento",
                  "value": "{{clienteDocumento}}",
                  "description": "CPF/CNPJ do cliente a ser identificado"
                },
                {
                  "key": "placa",
                  "value": "{{veiculoPlaca}}",
                  "description": "Placa validada contra o cliente identificado"
                }
              ]
            },
            "description": "Identifica o cliente por CPF/CNPJ, valida a placa informada e salva {{clienteId}} e {{veiculoId}} quando a abertura já estiver pronta."
          }
        },
        {
          "name": "Criar OS (com serviço e peça)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('osId', body.id);",
                  "    pm.collectionVariables.set('osNumero', body.numero);",
                  "    if (body.itensServico && body.itensServico.length > 0) {",
                  "        pm.collectionVariables.set('itemServicoId', body.itensServico[0].id);",
                  "        console.log('itemServicoId salvo:', body.itensServico[0].id);",
                  "    }",
                  "    console.log('osId salvo:', body.id);",
                  "    console.log('osNumero salvo:', body.numero);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"observacoes\": \"Cliente relata barulho ao frear e óleo baixo no painel\",\n  \"itensServico\": [\n    {\n      \"servicoId\": \"{{servicoId}}\",\n      \"observacoes\": \"Usar óleo sintético 5W30\"\n    }\n  ],\n  \"itensPeca\": [\n    {\n      \"pecaId\": \"{{pecaId}}\",\n      \"quantidade\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ordens",
              "host": ["{{baseUrl}}"],
              "path": ["ordens"]
