{
  "info": {
    "name": "SIASE - Sistema Integrado de Atendimento e Execução de Serviços",
    "description": "Coleção completa dos endpoints da API SIASE.\n\nFluxo completo de teste:\n1) Registrar usuário\n2) Login (salva {{jwtToken}})\n3) Criar Peça → salva {{pecaId}}\n4) Criar Serviço → salva {{servicoId}}\n5) Criar Cliente → salva {{clienteId}}\n6) Criar Veículo → salva {{veiculoId}}\n7) Criar OS → salva {{osId}} e {{osNumero}}\n8) Avançar status até ENTREGUE\n9) Acompanhar OS (sem token) pelo {{osNumero}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente ao fazer login"
    },
    {
      "key": "clienteId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente ao criar um cliente"
    },
    {
      "key": "veiculoId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente ao criar um veículo"
    },
    {
      "key": "pecaId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente ao criar uma peça"
    },
    {
      "key": "servicoId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente ao criar um serviço"
    },
    {
      "key": "osId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente ao criar uma OS"
    },
    {
      "key": "osNumero",
      "value": "",
      "type": "string",
      "description": "Número da OS (ex: OS-20260412-A3F7C2) — preenchido automaticamente ao criar uma OS"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "description": "Registro e login de usuários",
      "item": [
        {
          "name": "Registrar usuário",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"atendente1\",\n  \"password\": \"Atend@2024\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registrar",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registrar"]
            },
            "description": "Cadastra um novo usuário. Senha mínima de 8 caracteres. Retorna 201 com id, username e criadoEm."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('jwtToken', body.token);",
                  "    console.log('JWT salvo:', body.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"atendente1\",\n  \"password\": \"Atend@2024\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica e salva o token em {{jwtToken}} automaticamente."
          }
        }
      ]
    },
