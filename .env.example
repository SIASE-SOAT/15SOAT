# Copie este arquivo para .env e ajuste os valores para seu ambiente

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siase_db
DB_USER=siase_user
DB_PASSWORD=siase_pass

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVEF1dGhlbnRpY2F0aW9uMjAyNA==
JWT_EXPIRATION_MS=3600000

# CORS Configuration (comma-separated origins)
# Para desenvolvimento local: http://localhost:4200,http://localhost:3000
# Para Docker: http://siase-frontend:4200,http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://siase-frontend:4200

# Frontend/API Configuration
API_URL=http://localhost:8080/api
ENVIRONMENT=development
