# Copie este arquivo para .env e ajuste os valores para seu ambiente

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siase_db
DB_USER=siase_user
DB_PASSWORD=siase_pass

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVEF1dGhlbnRpY2F0aW9uMjAyNA==
JWT_EXPIRATION_MS=3600000

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://siase-frontend:4200

# External Service Tokens
WEBHOOK_TOKEN=siase-webhook-token-padrao

# Default User Credentials
MECANICO_PASSWORD=mecanico123

# Frontend/API Configuration
CLIENTE_PORTAL_URL=http://localhost:4200
API_URL=http://localhost:8080/api
ENVIRONMENT=development

# Email Configuration (Gmail SMTP)
# MAIL_USERNAME = seu email do gmail
# MAIL_PASSWORD = senha de app gerada em https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SIASE - Atendimento <seuemail@gmail.com>
