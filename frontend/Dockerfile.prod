# Docker build script para frontend
# Este arquivo garante que o build seja feito corretamente para produção

FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build -- --configuration production

FROM node:20-alpine
WORKDIR /app
RUN npm install -g serve
COPY --from=builder /app/dist/frontend /app/dist
EXPOSE 4200
CMD ["serve", "-s", "dist", "-l", "4200"]
